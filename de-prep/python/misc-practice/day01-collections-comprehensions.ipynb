    "# map, filter, reduce and zip\n",
    "import random\n",
    "from functools import reduce\n",
    "lambda_list = [random.randint(10,50) for i in range(10)]\n",
    "\n",
    "#map\n",
    "mapped_list = list(map(lambda x : (x*2), lambda_list))\n",
    "\n",
    "#filter\n",
    "filtered_list = list(filter(lambda x : (x%5==0), lambda_list))\n",
    "print(f\"filtered list : {filtered_list}\")\n",
    "\n",
    "#zip\n",
    "zipped_list = list(zip(lambda_list, mapped_list))\n",
    "print(f\"lambda list : {lambda_list}\\nmapped list : {mapped_list}\\nzipped list : {zipped_list}\")\n",
    "\n",
    "#reduce\n",
    "reduced_value = reduce(lambda a,b : (a+b), lambda_list)\n",
    "print(f\"reduced value : {reduced_value}\")"
