   ],
   "source": [
    "# Polymorphism and Method Overriding\n",
    "\n",
    "# Sadly, we dont have method overloading in Python which is similar to Java. If we want to use it, we need to have default \n",
    "# Parameter values\n",
    "\n",
    "class Animal:\n",
    "    def __init__(self):\n",
    "        print(\"Animal Constructor\")\n",
    "    def make_some_noise(self):\n",
    "        print(\"Animal Noises\")\n",
    "class Dog(Animal):\n",
    "   \n",
    "    def make_some_noise(self):\n",
    "        print(\"Dog Barks\")\n",
    "class Cat(Animal):\n",
    "    def __init__(self):             # Overwrites Animal __init__() constructor\n",
    "        print(\"Cat Constructor\")\n",
    "    def make_some_noise(self):\n",
    "        print(\"Cat meows\")\n",
    "class Husky(Dog):\n",
    "    def __init__(self):\n",
    "        print(\"Husky's constructor\")\n",
    "    def make_some_noise(self):\n",
    "        print(\"Husky irritates\")\n",
    "dog = Dog()\n",
    "dog.make_some_noise()"
   ]
