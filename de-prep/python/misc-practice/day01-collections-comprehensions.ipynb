    "# Counter, Default dict, named tuple, dequeue\n",
    "\n",
    "from collections import Counter, defaultdict, namedtuple, deque\n",
    "from random import randint\n",
    "\n",
    "listx = [randint(1,50) for x in range(10)]\n",
    "\n",
    "#Counter -> use any collection in () of counter. Use most_common(n) to find top n repeated elements from the collection/sequence\n",
    "countr = Counter(listx).most_common(3)\n",
    "print(Counter('pavankalyan'))\n",
    "print(countr)\n",
    "\n",
    "#Default Dict\n",
    "dict1 = {\"name\": \"Pavan\", \"age\": 21}\n",
    "dict2 = {\"name\": \"Kalyan\", \"height\": 166}\n",
    "dd = defaultdict(list)\n",
    "\n",
    "for d in (dict1,dict2):\n",
    "    for key, value in d.items():\n",
    "        dd[key].append(value)\n",
    "print(dict(dd))\n",
    "print(dict1.items())\n",
    "\n",
    "# DeQueue\n",
    "recent = deque(maxlen=3) # keeps only the last 3 items\n",
    "for x in range(5):\n",
    " recent.append(x)\n",
    "print(recent)\n",
    "\n",
    "#Named Tuple\n",
    "Order = namedtuple(\"kalyan\", [\"id\", \"amount\", \"location\"])\n",
    "o = Order(1, 99.5, \"city\")\n",
    "print(o.location) \n",
    "print(o)"
   ]
