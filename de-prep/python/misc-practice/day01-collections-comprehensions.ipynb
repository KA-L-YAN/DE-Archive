   "metadata": {},
   "source": [
    "### Name mangling (`__name`)\n",
    "\n",
    "**Purpose:** avoid name clashes in **subclasses**, not security.\n",
    "\n",
    "- `self.__make` in `Car` becomes `_Car__make` (compile time); still reachable as `obj._Car__make`.\n",
    "- Only names starting with `__` and not ending with `__`.\n",
    "- `@property` = read-only getter; `@x.setter` adds validation.\n",
    "\n",
    "⚠️ Setter line is a **SyntaxError** (assignment inside a conditional expression). Use a normal `if/else` and `raise ValueError`.\n",
    "⚠️ `get_details()` returns a **set** (no `key: value` pairs), so order is random.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6f3f1c61",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{'Year : 2027', 'Make : Tesla', 'Model : roadster', 'Price : 200000.0'}\n"
     ]
    }
   ],
   "source": [
    "class Car:\n",
    "    def __init__(self, make, model, manufactured_year, on_road_price):\n",
    "        self.__make = make\n",
    "        self.__model = model\n",
    "        self.__manufactured_year = manufactured_year\n",
    "        self.__on_road_price = on_road_price\n",
    "\n",
    "    @property\n",
    "    def make(self):\n",
    "        return self.__make\n",
    "    @property\n",
    "    def model(self):\n",
    "        return self.__model\n",
    "    @property\n",
    "    def manufactured_year(self):\n",
    "        return self.__manufactured_year\n",
    "    @property\n",
    "    def on_road_price(self):\n",
    "        return self.__on_road_price\n",
    "    \n",
    "    @on_road_price.setter\n",
    "    def on_road_price(self, price):\n",
    "        print(\"Zero Value Error\") if price <= 0 else self.__on_road_price = price\n",
    "\n",
    "    def get_details(self):\n",
    "        return {f\"Make : {self.__make}\",\n",
    "                f\"Model : {self.__model}\",\n",
    "                f\"Year : {self.__manufactured_year}\",\n",
    "                f\"Price : {self.__on_road_price}\"}\n",
    "\n",
    "new_car = Car('Tesla', 'roadster', '2027', 200_000.00)\n",
    "print(new_car.get_details())"
   ]
  },
