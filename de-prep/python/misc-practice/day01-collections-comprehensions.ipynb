    "# custom Exception\n",
    "\n",
    "class CustomException(Exception):\n",
    "    def __init__(self, msg):\n",
    "        super().__init__(msg)\n",
    "\n",
    "#Exception Handling\n",
    "class Try_it_out:\n",
    "#All the normal methods except static methods inside a class need to have \"self\" in the parameters or else use @staticmethod decorator on top of method definition\n",
    "    def open_the_file(self, filename: str) -> None:\n",
    "        try:\n",
    "            with open(filename, encoding='utf-8') as file:\n",
    "                head = file.readline()\n",
    "            raise CustomException(\"File has been opened\")\n",
    "        except FileNotFoundError as fnf:\n",
    "            print(f\"Stack trace : {fnf}\")\n",
    "        except Exception as e:\n",
    "            print(f\"Yooo you got an error \\n{e}\")\n",
    "        else:\n",
    "            print(head)\n",
    "        finally:\n",
    "            print(\"bye...\")\n",
    "try_it = Try_it_out()\n",
    "try_it.open_the_file(\"Liked_Songs.csv\")"
   ]
  },
