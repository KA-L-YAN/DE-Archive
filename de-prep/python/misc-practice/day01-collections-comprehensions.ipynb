   "source": [
    "### Inheritance\n",
    "\n",
    "**Takeaway:** `class Porsche(Vehicle)` → the child gets the parent's methods and properties (Java's `extends`).\n",
    "\n",
    "- `super().__init__(...)` runs the parent's constructor so the parent's attributes get set. Unlike Java, it need not be the first line, but call it before using parent state.\n",
    "- Parent's `self.__name` is mangled to `_Vehicle__name`, so the child can't write `self.__name` (it would become `_Porsche__name`). Go through the property (`self.name`).\n",
    "- `__turbo` → `_Porsche__turbo`: no getter, so it is only reachable as `obj._Porsche__turbo`. It is also never used.\n",
    "- `@x.setter` must come **after** the `@property` getter of the same name (order matters).\n",
    "- `revv()` uses `self.name`, so it works for any subclass.\n",
    "\n",
    "⚠️ Nits (code unchanged): `INHERITENCE` typo, stray `;` after `return self.__energy_type`, `wheeler_type=2` for a car, `new_car` is reused as a variable name (now a `Porsche`, earlier a `Car`).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "41c4e621",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Porsche GT 911 says Vroom, Vroom\n"
     ]
    }
   ],
   "source": [
    "# INHERITENCE\n",
    "# Just like Java, Python inheritence lets the child class use the parent class's methods and variables. \n",
    "# Only syntax changes here as well\n",
    "# Note: We need to have getters first if we want to have setters in our class. Order Matters\n",
    "\n",
    "class Vehicle:\n",
    "    def __init__(self, name, wheeler_type, energy_type, horse_power):\n",
    "        self.__name = name\n",
    "        self.__wheeler_type = wheeler_type\n",
    "        self.__energy_type = energy_type\n",
    "        self.__horse_power = horse_power\n",
    "\n",
    "    def revv(self):\n",
    "        print(f\"{self.name} says Vroom, Vroom\")\n",
    "\n",
    "    @property\n",
    "    def name(self):\n",
    "        return self.__name\n",
    "    @name.setter\n",
    "    def name(self, name):\n",
    "        self.__name = name\n",
    "\n",
    "    @property\n",
    "    def wheeler_type(self):\n",
    "        return self.__wheeler_type\n",
    "    @wheeler_type.setter\n",
    "    def wheeler_type(self, wheels):\n",
    "        self.__wheeler_type = wheels\n",
    "    \n",
    "    @property\n",
    "    def energy_type(self):\n",
    "        return self.__energy_type;\n",
    "    @energy_type.setter\n",
    "    def energy_type(self, energy):\n",
    "        self.__energy_type = energy\n",
    "\n",
    "    @property\n",
    "    def horse_power(self):\n",
    "        return self.__horse_power\n",
    "    @horse_power.setter\n",
    "    def horse_power(self, hp):\n",
    "        self.__horse_power = hp\n",
    "\n",
    "\n",
    "class Porsche(Vehicle):      # (Vehicle) instead of extends...\n",
    "    # If we're gonna inherit a class then the child class should absolutely inherit the parent class properties before instantiating parent class object\n",
    "    def __init__(self, name, wheeler_type, energy_type, horse_power, turbo = True):\n",
    "        #similar to super() in Java\n",
    "        super().__init__(name, wheeler_type, energy_type, horse_power)\n",
    "        self.__turbo = turbo\n",
    "\n",
    "\n",
    "new_car = Porsche(\"Porsche GT 911\", 2, \"Petrol\", 1200, True)\n",
    "new_car.revv()\n"
   ]
  },
